pipeline {
    agent any

    tools {
        jdk 'jdk-11'
    }

    parameters {
        string(name: 'jSS7_MAJOR_VERSION_NUMBER', defaultValue: '9.0.0', description: 'The major version for Naikeri jSS7')
        string(name: 'jSS7_BUILD', defaultValue: '', description: 'The build number of Naikeri jSS7 to use (leave empty for last successful)')
        string(name: 'WILDFLY_VERSION', defaultValue: '24.0.1.Final', description: 'WildFly version to use')
        string(name: 'jSS7_PROJECT_PATH', defaultValue: 'SS7/Naikeri-jSS7', description: 'Jenkins folder path for the upstream Naikeri-jSS7 multibranch pipeline')
    }

    stages {
        stage('Get jSS7 Artifact') {
            steps {
                script {
                    def buildNumber = params.jSS7_BUILD?.trim() ? params.jSS7_BUILD : ''
                    def selector = buildNumber ? "specific build ${buildNumber}" : "last successful build"
                    def projectPath = params.jSS7_PROJECT_PATH ?: 'SS7/Naikeri-jSS7'
                    def projectName = "${projectPath}/${env.BRANCH_NAME.replace('/', '%2F')}"
                    echo "Copying jSS7 artifact from ${selector} of ${projectName}"
                    copyArtifacts(
                        projectName: projectName,
                        selector: buildNumber ? specific(buildNumber) : lastSuccessful(),
                        filter: "release/Naikeri-jSS7-${params.jSS7_MAJOR_VERSION_NUMBER}-*.zip",
                        flatten: true
                    )
                    def zipFile = sh(script: "ls Naikeri-jSS7-*.zip", returnStdout: true).trim()
                    env.JSS7_ZIP = zipFile
                    env.JSS7_VERSION = zipFile.replace('Naikeri-jSS7-', '').replace('.zip', '')
                    echo "Using jSS7 artifact: ${env.JSS7_ZIP}"
                }
            }
        }

        stage('Get WildFly') {
            steps {
                withCredentials([usernamePassword(credentialsId: '426e8cfb-a47c-4fd2-96ae-713c541dc3f6',
                                                  usernameVariable: 'ART_USER',
                                                  passwordVariable: 'ART_PASS')]) {
                    sh """
                        wget -q --user=\${ART_USER} --password=\${ART_PASS} --no-check-certificate \
                        'https://ec2-56-126-119-82.sa-east-1.compute.amazonaws.com/artifactory/libs-release-local/com/naikeri/wildfly/wildfly/${params.WILDFLY_VERSION}/wildfly-${params.WILDFLY_VERSION}.zip' \
                        -O wildfly-${params.WILDFLY_VERSION}.zip
                        echo "WildFly downloaded successfully"
                    """
                }
            }
        }

        stage('Prepare WildFly') {
            steps {
                withCredentials([usernamePassword(credentialsId: '426e8cfb-a47c-4fd2-96ae-713c541dc3f6',
                                                  usernameVariable: 'ART_USER',
                                                  passwordVariable: 'ART_PASS')]) {
                    sh """
                        unzip -q wildfly-${params.WILDFLY_VERSION}.zip
                        unzip -q \${JSS7_ZIP} -d jss7-dist

                        # Install org.apache.logging.log4j WildFly module so the jSS7 modules' log4j2
                        # dependency resolves at server startup. Vanilla WildFly 24 only ships
                        # org.apache.logging.log4j.api (API-only); the jSS7 module.xml templates
                        # declare a dependency on org.apache.logging.log4j (API + implementation).
                        LOG4J_VERSION=2.26.0
                        ART_BASE='https://ec2-56-126-119-82.sa-east-1.compute.amazonaws.com/artifactory/libs-release-local/org/apache/logging/log4j'
                        LOG4J_MOD_DIR=wildfly-${params.WILDFLY_VERSION}/modules/system/layers/base/org/apache/logging/log4j/main

                        mkdir -p \$LOG4J_MOD_DIR
                        wget -q --user=\${ART_USER} --password=\${ART_PASS} --no-check-certificate \
                            "\$ART_BASE/log4j-api/\$LOG4J_VERSION/log4j-api-\$LOG4J_VERSION.jar" \
                            -O \$LOG4J_MOD_DIR/log4j-api-\$LOG4J_VERSION.jar
                        wget -q --user=\${ART_USER} --password=\${ART_PASS} --no-check-certificate \
                            "\$ART_BASE/log4j-core/\$LOG4J_VERSION/log4j-core-\$LOG4J_VERSION.jar" \
                            -O \$LOG4J_MOD_DIR/log4j-core-\$LOG4J_VERSION.jar

                        echo '<?xml version="1.0" encoding="UTF-8"?>' > \$LOG4J_MOD_DIR/module.xml
                        echo '<module xmlns="urn:jboss:module:1.9" name="org.apache.logging.log4j">' >> \$LOG4J_MOD_DIR/module.xml
                        echo '    <resources>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '        <resource-root path="log4j-api-2.26.0.jar"/>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '        <resource-root path="log4j-core-2.26.0.jar"/>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '    </resources>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '    <dependencies>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '        <module name="java.logging"/>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '        <module name="java.desktop"/>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '        <module name="java.management"/>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '    </dependencies>' >> \$LOG4J_MOD_DIR/module.xml
                        echo '</module>' >> \$LOG4J_MOD_DIR/module.xml

                        echo "WildFly and jSS7 extracted; log4j2 \$LOG4J_VERSION module installed"
                    """
                }
            }
        }

        stage('Deploy jSS7 into WildFly') {
            steps {
                withAnt(installation: 'Ant_1.10.15') {
                    sh """
                        export JBOSS_HOME=\$(pwd)/wildfly-${params.WILDFLY_VERSION}
                        cd jss7-dist/Naikeri-jSS7-\${JSS7_VERSION}/ss7-wildfly
                        ant -f build.xml deploy
                        echo "jSS7 deployed into WildFly"
                    """
                }
            }
        }

        stage('Package WildFly+jSS7') {
            steps {
                script {
                    def packageName = "Naikeri-jSS7-WildFly-${env.JSS7_VERSION}.zip"
                    def packageDir = "Naikeri-jSS7-WildFly-${env.JSS7_VERSION}"
                    env.PACKAGE_NAME = packageName
                    sh """
                        mkdir ${packageDir}
                        mv wildfly-${params.WILDFLY_VERSION}/ ${packageDir}/wildfly-${params.WILDFLY_VERSION}/
                        zip -qr ${packageName} ${packageDir}/
                        echo "Package created: ${packageName}"
                    """
                }
            }
        }

        stage('Save Artifacts') {
            steps {
                echo "Archiving ${env.PACKAGE_NAME}"
                archiveArtifacts artifacts: "Naikeri-jSS7-WildFly-*.zip", followSymlinks: false, onlyIfSuccessful: true
            }
        }
    }

    post {
        success {
            echo "Successfully built Naikeri jSS7 WildFly package: ${env.PACKAGE_NAME}"
        }
        failure {
            echo "Build failed"
        }
        always {
            cleanWs()
        }
    }
}